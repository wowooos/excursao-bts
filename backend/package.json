{
  "name": "excursao-bts-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "tsc",
    "start": "node-pg-migrate up -m src/db/migrations && node dist/server.js",
    "migrate:create": "node-pg-migrate create -m src/db/migrations",
    "migrate:up": "node-pg-migrate up -m src/db/migrations",
    "migrate:down": "node-pg-migrate down -m src/db/migrations"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mercadopago": "^3.2.0",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.6",
    "node-pg-migrate": "^9.0.0",
    "typescript": "^5.5.0"
  }
}
